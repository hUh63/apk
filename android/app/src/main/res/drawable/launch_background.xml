<?xml version="1.0" encoding="utf-8"?>
<!-- 启动背景（兜底版本）：纯主题色。
     注意：不能在此用 <bitmap src="@mipmap/ic_launcher"> —— Android 8+(v26) 起
     ic_launcher 是 adaptive-icon XML，BitmapDrawable 无法解析，会导致启动崩溃；
     图标展示由 Android 12+ 系统启动画面（windowSplashScreenAnimatedIcon）负责。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_bg" />
</layer-list>
